<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <View
            android:id="@+id/viewDurumSeridi"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="#009688"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvIlacAdi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="İlaç Adı"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/viewDurumSeridi"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDurumBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#E0F2F1"
            android:padding="4dp"
            android:text="DURUM"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@id/tvIlacAdi"
            app:layout_constraintStart_toEndOf="@id/tvIlacAdi"
            app:layout_constraintTop_toTopOf="@id/tvIlacAdi" />

        <TextView
            android:id="@+id/tvStokAdedi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Stok: 0"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvIlacAdi"
            app:layout_constraintTop_toBottomOf="@id/tvIlacAdi" />

        <TextView
            android:id="@+id/tvFiyat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="0.00 TL"
            android:textStyle="bold"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tvStokAdedi"
            app:layout_constraintStart_toEndOf="@id/tvStokAdedi"
            app:layout_constraintTop_toTopOf="@id/tvStokAdedi" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_play"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>